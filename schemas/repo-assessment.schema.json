{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude Panel repository assessment",
  "type": "object",
  "required": ["generatedAt", "repoRoot", "checkoutRoot", "node", "projects", "claude"],
  "properties": {
    "generatedAt": { "type": "string" },
    "repoRoot": { "type": "string" },
    "checkoutRoot": { "type": "string" },
    "branch": { "type": ["string", "null"] },
    "node": { "type": "object" },
    "projects": { "type": "array" },
    "claude": { "type": "object" },
    "recommendation": { "type": "object" }
  }
}
