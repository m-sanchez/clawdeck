{
  "type": "row",
  "gap": 6,
  "height": 44,
  "verticalAlignment": "center",
  "children": [
    {
      "type": "image",
      "source": { "bind": "data.pet" },
      "width": 52,
      "height": 42,
      "stretch": "uniform",
      "backgroundColor": "#00000000"
    },
    {
      "type": "column",
      "gap": 0,
      "width": 112,
      "verticalAlignment": "center",
      "children": [
        {
          "type": "text",
          "fontSize": 12,
          "fontWeight": "semibold",
          "width": 112,
          "trimming": "characterEllipsis",
          "color": { "bind": "data.foreground", "fallback": "#FF202520" },
          "segments": [
            { "bind": "data.headline", "fallback": "Ocelin offline" }
          ]
        },
        {
          "type": "text",
          "fontSize": 11,
          "width": 112,
          "trimming": "characterEllipsis",
          "color": { "bind": "data.secondary", "fallback": "#FF47534A" },
          "segments": [
            { "bind": "data.detail", "fallback": "Open Ocelin to connect" }
          ]
        }
      ]
    },
    {
      "type": "button",
      "glyph": "\uE8A7",
      "action": "openOcelin",
      "width": 22,
      "height": 28,
      "fontSize": 12,
      "color": { "bind": "data.secondary", "fallback": "#FF47534A" }
    }
  ]
}
