{
  "type": "row",
  "gap": 8,
  "children": [
    {
      "type": "button",
      "glyph": "\uE950",
      "action": "openOcelin",
      "tooltip": "Open Ocelin",
      "width": 28,
      "height": 28,
      "fontSize": 18,
      "color": { "bind": "data.accent", "fallback": "#FF85530B" }
    },
    {
      "type": "column",
      "gap": 2,
      "children": [
        {
          "type": "text",
          "fontSize": 12,
          "color": { "bind": "data.foreground", "fallback": "#FF202520" },
          "segments": [
            { "bind": "data.headline", "fallback": "Ocelin offline" }
          ]
        },
        {
          "type": "text",
          "fontSize": 10,
          "color": { "bind": "data.secondary", "fallback": "#FF47534A" },
          "segments": [
            { "bind": "data.detail", "fallback": "Open Ocelin to connect" }
          ]
        }
      ]
    }
  ]
}
