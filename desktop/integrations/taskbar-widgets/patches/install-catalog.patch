+async function waitForInstalledWidget(id, version) {
+  let catalogError = "";
+  for (let attempt = 0; attempt < 20; attempt++) {
+    const loaded = await invoke("load_state");
+    const manifest = loaded.widgetCatalog?.widgets?.find((widget) =>
+      widget.id === id && widget.version === version);
+    if (manifest?.valid) {
+      applyRuntimeCatalog(loaded.widgetCatalog);
+      if (!isKnownWidget(id)) throw new Error("The installed widget's renderer is not supported by Settings");
+      return;
+    }
+    catalogError = manifest?.error || catalogError;
+    if (attempt < 19) await new Promise((resolve) => setTimeout(resolve, 500));
+  }
+  throw new Error(catalogError || `The runtime catalog did not confirm ${id} v${version}`);
+}
