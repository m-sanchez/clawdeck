+std::wstring GetNativeWidgetPrimaryAction(const std::wstring& id) {
+    const auto* definition = FindDynamicWidget(id);
+    if (!definition || !definition->layout ||
+        _wcsicmp(definition->renderer.c_str(), L"native") != 0) {
+        return L"";
+    }
+    const auto action = JsonString(definition->layout, L"action");
+    if (action.empty() || action.size() > 120 ||
+        !std::all_of(action.begin(), action.end(), [](wchar_t value) {
+            return (value >= L'a' && value <= L'z') ||
+                   (value >= L'A' && value <= L'Z') ||
+                   (value >= L'0' && value <= L'9') ||
+                   value == L'.' || value == L'-' || value == L'_' ||
+                   value == L':';
+        })) {
+        return L"";
+    }
+    return action;
